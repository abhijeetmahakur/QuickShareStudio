# Copy to `.env` (gitignored) and build with:  flutter run --dart-define-from-file=.env
# All keys are optional. Without TURN, devices behind strict/symmetric NATs (some mobile
# networks, corporate Wi-Fi) may not be able to connect over the internet.

# STUN servers, comma separated (free, no credentials needed).
# The built-in default includes Google STUN 0-4 and Cloudflare STUN.
STUN_URLS=

# Optional static TURN override. The built-in default uses Open Relay's public credentials;
# for production deployments, use TURN credentials from a server/provider you control.
# Use comma-separated URLs and provide the associated username and credential below.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Only use relayed (TURN) candidates. For testing the TURN fallback; leave false.
FORCE_TURN=false

# PeerJS signaling server. The default is the free PeerJS Cloud.
PEER_SERVER_HOST=0.peerjs.com
PEER_SERVER_PORT=443
PEER_SERVER_SECURE=true
